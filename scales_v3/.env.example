# SCALES v3.0 — API keys (never commit this file)
# Fill blanks; keep unused keys empty.

# --- Gemini (Google AI Studio) — use 1 key, or up to 5 for rate-limit rotation ---
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
# Or comma-separated pool:
# GOOGLE_API_KEYS=key1,key2,key3

# --- Cerebras (https://cloud.cerebras.ai) ---
# Models: cerebras/llama3.1-8b , cerebras/llama-3.3-70b
CEREBRAS_API_KEY=

# --- Z.ai GLM (https://z.ai/manage-apikey/apikey-list) ---
ZAI_API_KEY=
# Optional: ZAI_API_BASE=https://api.z.ai/api/paas/v4
# Coding Plan: ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4

# --- OpenRouter / Groq (fallbacks) ---
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Mistral (https://console.mistral.ai) ---
# Models: mistral/mistral-small-2506 , mistral/mistral-large-2512
MISTRAL_API_KEY=

# --- Optional ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
